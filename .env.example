# Reference values only. VisionClass reads process environment variables; it
# does not automatically load this file. Set values in your shell or launcher.

VISIONCLASS_APP_PORT=8766
VISIONCLASS_RUNS_DIR=data/visionclass_runs
VISIONCLASS_MAX_UPLOAD_BYTES=1073741824
VISIONCLASS_MAX_MULTIPART_OVERHEAD_BYTES=1048576

# Optional model/data overrides; paths are resolved from the working directory.
# VISIONCLASS_BEHAVIOR_MODEL=runs/detect/.../weights/best.pt
# VISIONCLASS_PERSON_MODEL=yolo11n.pt
# VISIONCLASS_PRETRAINED_MODEL=yolo11n.pt
# VISIONCLASS_DATASET_YAML=datasets/student_classroom_behavior/data.yaml
# VISIONCLASS_VIDEO=data/videos/classroom.mp4
# VISIONCLASS_VIDEO_OUTPUT=data/videos/classroom_result.mp4
# VISIONCLASS_TRACKING_OUTPUT=data/videos/classroom_tracking.mp4
# VISIONCLASS_HISTORY_VIDEO_OUTPUT=data/videos/classroom_history.mp4
# VISIONCLASS_HISTORY_CSV=data/classroom_behavior_history.csv
# VISIONCLASS_SUMMARY_CSV=data/classroom_behavior_summary.csv

# Inference defaults preserve the approved production settings.
# VISIONCLASS_DEVICE=auto
# VISIONCLASS_WEBCAM_INDEX=0
# VISIONCLASS_BEHAVIOR_CONF=0.20
# VISIONCLASS_PERSON_CONF=0.30
# VISIONCLASS_INFERENCE_IMGSZ=960
